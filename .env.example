# Copy to .env to override the defaults in docker-compose.yml. Never commit .env.
POSTGRES_USER=circ
POSTGRES_PASSWORD=circ
POSTGRES_PORT=5432

# The address the published ports listen on. The default keeps every service on this machine only;
# set 0.0.0.0 to reach them from other machines on the network.
BIND_ADDR=127.0.0.1

# Ask Circularity (B16b): a free key from console.groq.com. Leave empty to use the demo's prepared answers.
GROQ_API_KEY=
