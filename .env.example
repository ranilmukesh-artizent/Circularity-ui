# Copy to .env to override the defaults in docker-compose.yml. Never commit .env.
POSTGRES_USER=circ
POSTGRES_PASSWORD=circ

# Host ports (the containers' own ports stay fixed). Change one when it is taken on this machine. The Node
# smoke scripts take the URL as an argument (default: WEB_PORT / SIM_PORT from the shell environment, not this file).
# scripts/dev asks Compose for the published ports, so it follows this file.
POSTGRES_PORT=5432
WEB_PORT=5173
API_PORT=8000
SIM_PORT=8100
SFTP_PORT=2222

# File watching for hot reload: 1 = poll (bind mounts that deliver no change events: a Windows drive, some VMs),
# 0 = never poll; empty = poll only under a WSL2 kernel.
DEV_POLLING=

# The address the published ports listen on. The default keeps every service on this machine only;
# set 0.0.0.0 to reach them from other machines on the network.
BIND_ADDR=127.0.0.1

# Ask Circularity (B16b): a free key from console.groq.com. Leave empty to use the demo's prepared answers.
GROQ_API_KEY=
# Optional second provider (Google AI Studio key): its models join the chain as fallbacks. Empty = Groq only.
GEMINI_API_KEY=
# Models tried in order when one is rate limited (comma-separated groq:<model id>); empty = GROQ_MODEL only.
# ASK_MODEL_CHAIN=groq:openai/gpt-oss-120b,groq:llama-3.3-70b-versatile

# di-api settings and signing secrets (D2). DI_ENV is dev, test or prod. Outside dev the api refuses to start with the
# shipped development secrets or with a secret shorter than 32 bytes. Empty = the dev defaults (fine for local use).
# Make one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
DI_ENV=dev
# signs the sign-in tokens (HS256)
DI_JWT_SECRET=
# signs source-sim's change events to di-api (di sends it to source-sim when it subscribes)
DI_WEBHOOK_SECRET=
# encrypts the source credentials people enter in the Connection Fabric (Fernet; required outside dev).
# Make one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotation: a comma-separated list "NEW,OLD" (the first encrypts, every one decrypts); then run
# bash scripts/dev/reencrypt-secrets.sh and keep only NEW (docs/agents/runbook-fabric.md, Credentials).
DI_SECRET_KEY=

# P9-0.9: start the case autopilot (the agent below, as a playbook run that holds its decision for a person) when a
# case opens. Off by default. A case opened by a workflow or import has no person: the account is who the agent acts for.
# DI_AUTOPILOT_ON_OPEN=false
# DI_AUTOPILOT_AGENT=coordinator
# DI_AUTOPILOT_ACCOUNT=

# Plan 5: OpenTelemetry. Empty = off (nothing is exported, nothing changes). Set an OTLP/HTTP collector, e.g. http://otel:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=
# DI_OTEL_LOGS=false
# DI_OTEL_CAPTURE_CONTENT=false
# Host ports of the opt-in otel service (docker-compose.otel.yml): Grafana and the OTLP/HTTP receiver.
# OTEL_GRAFANA_PORT=3000
# OTEL_OTLP_PORT=4318
