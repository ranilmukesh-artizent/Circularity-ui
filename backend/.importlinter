# Dependency direction of the di package (docs/agents/plans/01b-refactor.md, D5; finding F1; the layer folders of
# docs/agents/plans/07-restructure.md). Run from the backend folder:
#   lint-imports
# 1. Endpoints are leaves: di.routes holds every HTTP endpoint; only di.main (which mounts the routers) imports it.
# 2. The screen services (what each page area shows) are used only by their routes, and never import each other.
# 3. Layers: routes over the screen services, over the repositories (reads), over the case store, the canonical store
#    and the engine.
# 4. The foundations (di.core, di.models) import nothing above them.
[importlinter]
root_package = di
include_external_packages = False
# Imports under `if TYPE_CHECKING:` exist only for mypy (di.services.actions.registry names CallContext that way) and
# set no runtime dependency direction.
exclude_type_checking_imports = True

[importlinter:contract:routes-are-leaves]
name = Only di.main imports di.routes
type = forbidden
source_modules =
    di.connectors
    di.core
    di.mcp
    di.models
    di.repositories
    di.services
    di.worker
    di.workflow
forbidden_modules =
    di.routes

[importlinter:contract:screen-services-behind-routes]
name = Only di.routes imports the screen services
type = forbidden
source_modules =
    di.connectors
    di.core
    di.mcp
    di.models
    di.repositories
    di.services.actions
    di.services.ask
    di.services.canonical
    di.services.cases
    di.services.engine
    di.services.execution
    di.services.instructions
    di.services.modeler
    di.worker
    di.workflow
forbidden_modules =
    di.services.screens

[importlinter:contract:screens-independent]
name = Screen services do not import each other
type = independence
modules =
    di.services.screens.access
    di.services.screens.agents
    di.services.screens.analytics
    di.services.screens.audit
    di.services.screens.case
    di.services.screens.checks
    di.services.screens.command
    di.services.screens.home
    di.services.screens.integration
    di.services.screens.mcp
    di.services.screens.modeler
    di.services.screens.mywork
    di.services.screens.nav
    di.services.screens.orchestration
    di.services.screens.product
    di.services.screens.reference
    di.services.screens.refresh
    di.services.screens.toolfleet
    di.services.screens.workflows

[importlinter:contract:layers]
name = Routes over screen services over repositories over the case store, canonical store and engine
type = layers
layers =
    di.routes
    di.services.screens
    di.repositories
    di.services.cases : di.services.canonical : di.services.engine
# A stage move asks for the published case-triggered workflows (plan 6 C6): a lazy call-out in a savepoint that never
# fails the move, not a read dependency of the case store.
ignore_imports =
    di.services.cases.lifecycle -> di.workflow.triggers
    # Opening a case from data (plan 8, MVP-8.1) values it with the owner's published flow and the active model: the
    # one place a case is opened from data reads them, as a re-evaluation does.
    di.services.cases.intake -> di.repositories.live_rules
    di.services.cases.intake -> di.services.actions.models
    di.services.cases.intake -> di.repositories.plm
    # The live named demand of a tool (plan 9, P9-3.12) is a read of the canonical demand records: the queue plan reads it here.
    di.services.cases.intake -> di.repositories.tool_demand
    # The life facts of a tool (plan 9, P9-3.9) include PLM's rated life of its wear components: read here, as intake reads the BOM.
    di.services.cases.life_evidence -> di.repositories.plm
    # The template of a case can be a pack version published for its owner (plan 9, P9-1.6): intake reads it, as it reads
    # the owner's flow.
    di.services.cases.intake -> di.repositories.packs
    # A received device's case is built by the device flow (plan 9, P9-6.4): intake reads the trade-in, the market feed and
    # the owner's flow through di.services.device, as it reads the live rules.
    di.services.cases.intake -> di.services.device.intake
    di.services.cases.intake -> di.services.device.inputs
    # The payout of a received device is valued from the pack's market table (plan 9, P9-6.8, I-15).
    di.services.cases.intake -> di.services.device.payout
    # The case process layer (plan 9, P9-1.7) merges Home's approvals and tasks into My work, and reads the Approver's
    # out-of-office cover when it escalates: lazy reads of the workspace repository, as intake reads the live rules.
    di.services.cases.process -> di.repositories.workspace
    di.services.cases.process -> di.repositories.common

[importlinter:contract:foundations]
name = di.core and di.models import nothing above them
type = forbidden
source_modules =
    di.core
    di.models
forbidden_modules =
    di.connectors
    di.mcp
    di.repositories
    di.routes
    di.services
    di.worker
    di.workflow

# 5. The engine and the Modeler's policy core are pure (plan 8, R5): no database, state, clock or jobs, and nothing
#    above them. They read only the golden files and their packaged JSON.
[importlinter:contract:pure-core]
name = The engine and di.services.modeler are pure
type = forbidden
source_modules =
    di.services.engine
    di.services.modeler
forbidden_modules =
    di.connectors
    di.core.clock
    di.core.db
    di.core.jobs
    di.core.state
    di.mcp
    di.models
    di.repositories
    di.routes
    di.services.actions
    di.services.ask
    di.services.canonical
    di.services.cases
    di.services.execution
    di.services.instructions
    di.services.screens
    di.worker
    di.workflow
