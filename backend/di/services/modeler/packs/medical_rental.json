    "value": 1000,
    "action": "Approve when modelled rental income over the next period clearly exceeds the repair"
   },
   {
    "id": "AL-MR-TURNAROUND",
    "kind": "alert",
    "label": "Turnaround slipping at a depot",
    "owner": "operations_manager",
    "action": "Move decontamination capacity from a quieter depot",
    "params": {
     "avg_turnaround_days_gt": 2.5,
     "window_days": 14
    }
   },
   {
    "id": "SR-MR-SVCWEEK",
    "kind": "suggestion",
    "label": "service due within the next rental → service in the week of lowest regional demand"
   }
