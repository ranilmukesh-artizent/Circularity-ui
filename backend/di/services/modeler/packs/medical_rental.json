  "sample_diversions": [
   {
    "text": "from an isolation ward → enhanced decontamination",
    "op": {
     "id": "DV-MR-ISO",
     "op": "add_step",
     "stage": "match",
     "step": "Enhanced decontamination",
     "owner_role": "decontamination_lead",
     "when": [
      {
       "fact": "asset.ward_type",
       "op": "eq",
       "value": "isolation"
      }
     ]
    },
    "blocked": false,
    "reason": "Adds a step at Decontamination; the record is still required."
   },
   {
    "text": "same hospital asks again within 24 h → re-rent directly",
    "op": {
     "id": "DV-MR-SAME",
     "op": "shortcut",
     "stage": "decide",
     "to": "rerent",
     "when": [
      {
       "fact": "demand.same_hospital_within_24h",
       "op": "eq",
       "value": true
      }
     ]
    },
    "blocked": false,
    "reason": "Starts after the decontamination, service and recall gates; they still run."
   },
   {
    "text": "emergency request: skip the decontamination record",
    "op": {
     "id": "DV-MR-SKIP",
     "op": "shortcut",
     "stage": "receive",
     "to": "condition",
     "when": [
      {
       "fact": "request.priority",
       "op": "eq",
       "value": "emergency"
      }
     ],
     "blocked_suggestion": "dispatch an already decontaminated unit from the nearest depot"
    },
    "blocked": true,
    "reason": "Blocked: this skips the compliance guardrail G-MED-DECON, the decontamination record. Suggestion: dispatch an already decontaminated unit from the nearest depot."
   }
  ],
  "merge_rule": "stricter_wins"
