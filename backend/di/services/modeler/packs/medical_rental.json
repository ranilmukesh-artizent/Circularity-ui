 "prompts": [
  "Return to re-rent: when a pump, monitor, bed or other rental device comes back from a hospital, a decontamination record is required before anyone handles it; then inspect and test it and send it to the hospital that needs it next. A repair over $1,000 needs the fleet manager.",
  "Plan servicing around demand",
  "Retire or refurbish ageing devices"
 ],
 "clarify": {
  "question": "Should servicing be brought forward when it falls due within the next rental?",
  "options": [
   {
    "label": "Yes, always service first",
    "adds": "[{\"id\": \"BR-MR-SVC\", \"op\": \"business_rule\", \"text\": \"service due within the next rental → service then re-rent\", \"stage\": \"decide\", \"scope\": \"condition.service_due_within_rental == true\", \"action\": \"require\", \"path\": \"service_rerent\"}]"
   },
   {
    "label": "Only if the rental is longer than 30 days",
    "adds": "[{\"id\": \"BR-MR-SVC\", \"op\": \"business_rule\", \"text\": \"service due within the next rental → service then re-rent\", \"stage\": \"decide\", \"scope\": \"condition.service_due_within_rental == true and request.days > 30\", \"action\": \"require\", \"path\": \"service_rerent\"}]"
   }
  ]
 },
