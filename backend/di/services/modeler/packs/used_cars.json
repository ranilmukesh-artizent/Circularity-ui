 "kpis": [
  {
   "id": "gross_per_car",
   "label": "Gross per car",
   "definition": "realised net after channel costs / cars",
   "measure": {
    "kind": "avg",
    "of": "recommendation.net",
    "unit": "$"
   },
   "trend": "monthly"
  },
  {
   "id": "days_in_stock",
   "label": "Days in stock",
   "definition": "receipt to sale; modelled trend 42 to 31 days over 12 months",
   "measure": null,
   "trend": "monthly"
  },
  {
   "id": "retail_share",
   "label": "Retail share",
   "definition": "share of cars sent to a retail lot",
   "measure": null,
   "trend": "monthly"
  },
  {
   "id": "straight_through_pct",
   "label": "Straight-through share",
   "definition": "cars decided with no person in the loop / cars",
   "measure": null,
   "trend": "monthly"
  },
  {
   "id": "recon_cost_per_car",
   "label": "Recon cost per car",
   "definition": "reconditioning estimate / cars",
   "measure": {
    "kind": "avg",
    "of": "condition.recon_estimate",
    "unit": "$"
   },
   "trend": "monthly"
  },
  {
   "id": "held_by_guardrails_pct",
   "label": "Held by guardrails",
   "definition": "cars held by a gate or guardrail / cars",
   "measure": {
    "kind": "share",
    "where": [
     {
      "fact": "held_by_guardrails",
      "op": "eq",
      "value": true
     }
    ]
   },
   "trend": "monthly"
  }
 ],
