  }
 ],
 "prompts": [
  "Lease returns to best channel: when a leased car or a trade-in comes back, check title and finance, inspect it and estimate reconditioning, price it for retail on each of our lots, wholesale auction, dealer trade and salvage, and send it to the channel with the best gross after costs. Reconditioning over $2,500 needs the used-car manager.",
  "Trade-ins: retail or wholesale",
  "Move ageing stock between lots"
 ],
 "clarify": {
  "question": "Should cars with minor hail damage still be considered for retail?",
  "options": [
   {
    "label": "Yes, if repair is under the recon limit",
    "adds": "[{\"id\": \"BR-UC-HAIL\", \"op\": \"business_rule\", \"text\": \"hail damage under the recon limit stays retail-eligible\", \"stage\": \"decide\", \"scope\": \"condition.hail_damage == true and condition.recon_estimate <= 2500\", \"action\": \"allow\", \"path\": \"retail\"}]"
   },
   {
    "label": "No, send them to auction",
    "adds": "[{\"id\": \"BR-UC-HAIL-AUCTION\", \"op\": \"business_rule\", \"text\": \"hail damage goes to wholesale auction\", \"stage\": \"decide\", \"scope\": \"condition.hail_damage == true\", \"action\": \"require\", \"path\": \"auction\"}]"
   }
  ]
 },
