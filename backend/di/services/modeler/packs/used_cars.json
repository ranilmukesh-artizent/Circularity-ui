  {
   "question": "Why are EV crossovers sitting longer on our lots?",
   "chart": "bar",
   "query": {
    "group_by": "asset.lot_id",
    "measure": {
     "kind": "avg",
     "of": "asset.days_on_lot",
     "where": [
      {
       "fact": "asset.segment",
       "op": "eq",
       "value": "ev_crossover"
      }
     ]
    }
   }
  },
  {
   "question": "Which lots sell lease returns fastest?",
