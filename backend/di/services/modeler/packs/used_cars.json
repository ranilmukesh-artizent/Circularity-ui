  "sample_diversions": [
   {
    "text": "EV with battery health under 80% → battery assessment",
    "op": {
     "id": "DV-UC-EV",
     "op": "add_step",
     "stage": "condition",
     "step": "Battery assessment",
     "owner_role": "inspection_lead",
     "when": [
      {
       "fact": "condition.battery_soh",
       "op": "lte",
       "value": 79.99
      }
     ]
    },
    "blocked": false,
    "reason": "Adds a step at Inspect and estimate; no gate is skipped."
   },
   {
    "text": "over 120,000 miles → wholesale auction directly",
    "op": {
     "id": "DV-UC-MILES",
     "op": "shortcut",
     "stage": "condition",
     "to": "auction",
     "when": [
      {
       "fact": "asset.mileage_at_return",
       "op": "gte",
       "value": 120000
      }
     ]
    },
    "blocked": false,
    "reason": "Starts after the title, odometer and recall gates; the decide stage still runs."
   },
   {
    "text": "dealer trade within the group: skip the title check",
    "op": {
     "id": "DV-UC-SKIP",
     "op": "shortcut",
     "stage": "receive",
     "to": "condition",
     "when": [
      {
       "fact": "asset.return_kind",
       "op": "eq",
       "value": "trade_in"
      }
     ]
    },
    "blocked": true,
    "reason": "Blocked: this skips the compliance guardrail G-VEH-TITLE, clear title and no open finance."
   }
  ],
  "merge_rule": "stricter_wins"
 },
