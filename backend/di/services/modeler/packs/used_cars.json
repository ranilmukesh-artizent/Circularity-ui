   "stage": "execute",
   "locked": false,
   "forbids": [],
   "protects": [],
   "approvers": [],
   "param": null
  },
  {
   "id": "AP-UC-RECON",
   "text": "Recon over $2,500 → used-car manager",
   "owner": "used_car_manager",
   "type": "Approval",
   "stage": "decide",
   "locked": false,
   "forbids": [],
   "protects": [],
   "approvers": [
    "used_car_manager"
   ],
   "param": {
    "field": "condition.recon_estimate",
    "value": 2500,
    "stricter": "lower",
    "min": 500,
    "max": 5000
   }
  }
 ],
 "gates": [
