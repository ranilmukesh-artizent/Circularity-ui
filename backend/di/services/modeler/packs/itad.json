  }
 ],
 "prompts": [
  "Decommissioned and lease-end IT: when laptops, desktops, servers or network gear come back on a pickup, reconcile them with the manifest, sanitise every disk, then redeploy, return to the lessor, resell, harvest parts or recycle. A serial missing from the manifest is a critical exception.",
  "Reconcile every pickup with its manifest",
  "Sanitise before anything leaves our control"
 ],
 "clarify": null,
