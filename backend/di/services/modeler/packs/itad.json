  "sample_diversions": [
   {
    "text": "high security level \u2192 witnessed destruction",
    "op": {
     "id": "DV-IT-HIGH",
     "op": "add_step",
     "stage": "condition",
     "step": "Witnessed destruction",
     "owner_role": "compliance",
     "when": [
      {
       "fact": "asset.security_level",
       "op": "eq",
       "value": "high"
      }
     ]
    },
    "blocked": false,
    "reason": "Adds a step at Sanitise and test; no gate is skipped."
   },
   {
    "text": "urgent redeploy: skip the sanitisation record",
    "op": {
     "id": "DV-IT-SKIP",
     "op": "shortcut",
     "stage": "match",
     "to": "value",
     "when": [
      {
       "fact": "request.urgent",
       "op": "eq",
       "value": true
      }
     ]
    },
    "blocked": true,
    "reason": "Blocked: this skips the compliance guardrail G-DATA-1, the sanitisation record per media serial. Suggestion: redeploy an asset whose media are already sanitised."
   }
  ],
  "merge_rule": "stricter_wins"
 },
