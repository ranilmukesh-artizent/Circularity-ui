     "stage": "condition",
     "step": "Second state-of-health read",
     "owner_role": "battery_lead",
     "when": [
      {
       "fact": "battery.soh_pct",
       "op": "lt",
       "value": 60
      }
     ]
    },
    "blocked": false,
    "reason": "Adds a step at Read state of health; no gate is skipped."
   },
   {
    "text": "urgent resale: skip the dangerous-goods lane",
    "op": {
     "id": "DV-BAT-SKIP",
     "op": "shortcut",
     "stage": "match",
     "to": "reuse",
     "when": [
      {
       "fact": "battery.damaged",
       "op": "eq",
       "value": true
      }
     ]
    },
    "blocked": true,
    "reason": "Blocked: this skips the compliance guardrail G-BAT-4, the dangerous-goods lane for damaged packs. Suggestion: send the pack to a permitted recycler."
   }
  ],
  "merge_rule": "stricter_wins"
