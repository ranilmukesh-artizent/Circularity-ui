     "step": "Second check before donating",
     "owner_role": "compliance",
     "when": [
      {
       "fact": "valuer.itemClass",
       "op": "eq",
       "value": "footwear"
      }
     ]
    },
    "blocked": false,
    "reason": "Adds a step at Decide the route; no gate is skipped."
   },
   {
    "text": "unsold apparel: skip the destruction check",
    "op": {
     "id": "DV-B2C-SKIP",
     "op": "shortcut",
     "stage": "value",
     "to": "execute",
     "when": [
