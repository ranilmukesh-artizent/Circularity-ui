  {
   "key": "core_return",
   "name": "Dealer core returns"
  }
 ],
 "prompts": [
  "Automotive cores: when a dealer returns a used alternator, starter or transmission for its deposit, inspect it against the part's acceptance criteria, credit the deposit in full, in part or not at all, then remanufacture, harvest parts, sell to a broker or scrap it. A part from the wrong family, or a dealer who keeps returning rejected cores, is held for a person.",
  "Credit the deposit by the acceptance criteria",
  "Hold a suspect return for a person"
 ],
 "clarify": null,
 "classes": [
  {
   "id": "alternator",
   "name": "Alternator",
   "attrs": {
    "serialised": true,
    "has_media": false,
    "hazardous": false,
    "regulated": false,
    "patient_data": false
   },
   "new_price": 120
  },
  {
   "id": "starter",
   "name": "Starter",
   "attrs": {
    "serialised": true,
    "has_media": false,
