    "kind": "avg",
    "of": "recommendation.net / ref",
    "scale": 100,
    "unit": "%"
   },
   "trend": "monthly"
  },
  {
   "id": "days_to_sale",
   "label": "Days to sale",
   "definition": "receipt to the sale of the lot",
   "measure": null,
   "trend": "monthly"
  },
  {
   "id": "price_vs_forecast",
   "label": "Price realised against forecast",
   "definition": "realised price / forecast price",
   "measure": null,
   "trend": "monthly"
  },
  {
   "id": "straight_through",
   "label": "Straight-through %",
   "definition": "lots closed without a person changing data or the channel (approval by policy counts)",
   "measure": null,
   "trend": "monthly"
  },
  {
   "id": "wipe_compliance",
   "label": "Data-wipe compliance",
   "definition": "lots listed with a wipe certificate / lots listed",
   "measure": {
    "kind": "share",
    "where": [
     {
      "fact": "evidence_result.data_wipe",
      "op": "eq",
      "value": "pass"
     }
    ],
    "over": []
   },
   "trend": "monthly"
  },
  {
   "id": "grading_disputes",
   "label": "Grading disputes",
   "definition": "lots whose grade a buyer or an inspector disputed / lots graded",
   "measure": null,
   "trend": "monthly"
  }
 ],
