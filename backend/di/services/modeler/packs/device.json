 "guardrails": [
  {
   "id": "GR-D1",
   "text": "Certified data wipe before any listing",
   "owner": "Compliance",
   "type": "Compliance",
   "stage": "condition",
   "locked": true,
   "forbids": [],
   "protects": [
    [
     "wipe|certificate",
     "skip|without|\\bno\\b"
    ]
   ],
   "approvers": [],
   "param": null
  },
  {
   "id": "GR-D2",
   "text": "Recovery floor: below 55% of reference value goes to human review",
   "owner": "Recommerce Finance",
   "type": "Threshold",
   "stage": "value",
   "locked": false,
   "forbids": [],
   "protects": [
    [
     "floor",
     "lower|reduce|change|set|remove"
    ]
   ],
   "approvers": [],
   "param": {
    "field": "floor",
    "value": 0.55,
    "stricter": "higher",
    "min": 0.3,
    "max": 0.9
   }
  },
  {
   "id": "GR-D3",
   "text": "Grade D never listed on Buy Now or Marketplace",
   "owner": "Channel Ops",
   "type": "Compliance",
   "stage": "decide",
   "locked": true,
   "forbids": [
    {
     "path": "buynow",
     "actions": [
