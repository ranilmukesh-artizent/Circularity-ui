 "guardrails": [
  {
   "id": "GR-D1",
   "text": "Certified data wipe before any listing",
   "owner": "Compliance",
   "type": "Compliance",
   "stage": "condition",
   "locked": true,
   "forbids": [],
   "protects": [
    [
     "wipe|certificate",
     "skip|without|\\bno\\b"
    ]
   ],
   "approvers": [],
   "param": null
  },
  {
   "id": "GR-D2",
   "text": "Recovery floor: below 55% of reference value goes to human review",
   "owner": "Recommerce Finance",
   "type": "Threshold",
   "stage": "value",
   "locked": false,
   "forbids": [],
   "protects": [
    [
     "floor",
     "lower|reduce|change|set|remove"
    ]
   ],
   "approvers": [],
   "param": {
    "field": "floor",
    "value": 0.55,
    "stricter": "higher",
    "min": 0.3,
    "max": 0.9
   }
  },
  {
   "id": "GR-D3",
   "text": "Grade D never listed on Buy Now or Marketplace",
   "owner": "Channel Ops",
   "type": "Compliance",
   "stage": "decide",
   "locked": true,
   "forbids": [
    {
     "path": "buynow",
     "actions": [
      "require",
      "prefer"
     ],
     "scope_any": {
      "grade": [
       "D"
      ]
     }
    },
    {
     "path": "market",
     "actions": [
      "require",
      "prefer"
     ],
     "scope_any": {
      "grade": [
       "D"
      ]
     }
    }
   ],
   "protects": [],
   "approvers": [],
   "param": null
  },
  {
   "id": "GR-D4",
   "text": "Maximum lot size per channel",
   "owner": "Channel Ops",
   "type": "Threshold",
   "stage": "decide",
   "locked": false,
   "forbids": [],
   "protects": [
    [
     "lot size|lot limit",
     "raise|increase|remove|change"
    ]
   ],
   "approvers": [],
   "param": null
  },
  {
   "id": "GR-D5",
   "text": "Marketplace never undercuts the live Buy Now price",
   "owner": "Pricing",
   "type": "Threshold",
   "stage": "value",
   "locked": false,
   "forbids": [],
   "protects": [
    [
     "undercut"
    ]
   ],
   "approvers": [],
   "param": null
  },
  {
   "id": "GR-D6",
   "text": "Every routing approved by a named owner",
   "owner": "Governance board",
   "type": "Approval",
   "stage": "decide",
   "locked": false,
   "forbids": [],
   "protects": [
    [
     "auto-?approv|without approval|skip approval"
    ]
   ],
   "approvers": [],
   "param": null
  },
  {
   "id": "GR-D7",
   "text": "Blacklist and lock check before any sale",
   "owner": "Compliance",
   "type": "Compliance",
   "stage": "match",
   "locked": true,
   "forbids": [],
   "protects": [
    [
     "blacklist|activation lock|lock check|registry check",
     "skip|without|remove|\\bno\\b"
    ]
   ],
   "approvers": [],
   "param": null
  },
  {
   "id": "GR-D8",
   "text": "Price confidence: a thin, stale or wide price goes to the pricing analyst",
   "owner": "Pricing analyst",
   "type": "Data quality",
   "stage": "value",
   "locked": false,
   "forbids": [],
   "protects": [
    [
     "price confidence|confidence hold|price interval",
     "skip|remove|without|\\bno\\b"
    ]
   ],
   "approvers": [],
   "param": null
  },
  {
   "id": "GR-D13",
   "text": "Quote match: the device read must match the quote",
   "owner": "Customer care",
   "type": "Data quality",
   "stage": "match",
   "locked": false,
   "forbids": [],
   "protects": [
    [
     "quote match|quote check",
     "skip|remove|without|\\bno\\b"
    ]
   ],
   "approvers": [],
   "param": null
  },
  {
   "id": "GR-D11",
   "text": "Payout adjustment above 10% of the quote waits for Customer care",
   "owner": "Customer care",
   "type": "Threshold",
   "stage": "condition",
   "locked": false,
   "forbids": [],
   "protects": [
    [
     "payout gap|payout limit|max auto gap",
     "raise|increase|remove|skip|without|\\bno\\b"
    ]
   ],
   "approvers": [],
   "param": {
    "field": "max_auto_gap",
    "value": 0.1,
    "stricter": "lower",
    "min": 0.0,
    "max": 0.25
   }
  },
  {
   "id": "GR-D10",
   "text": "A wholesale lot worth more than $25,000 waits for the Commercial manager",
   "owner": "Commercial manager",
   "type": "Approval",
   "stage": "decide",
   "locked": false,
   "forbids": [],
   "protects": [
    [
     "lot value|lot limit|wholesale limit",
     "raise|increase|remove|skip|without|\\bno\\b"
    ]
   ],
   "approvers": [],
   "param": {
    "field": "max_value_usd",
    "value": 25000,
    "stricter": "lower",
    "min": 0,
    "max": 100000
   }
  },
  {
   "id": "GR-D12",
   "text": "A wholesale lot is sold only to an approved buyer",
   "owner": "Channel Ops",
   "type": "Compliance",
   "stage": "decide",
   "locked": true,
   "forbids": [],
   "protects": [
    [
     "approved buyer|buyer list|wholesale buyer",
     "skip|without|\\bno\\b|any buyer"
    ]
   ],
   "approvers": [],
   "param": null
  }
 ],
 "gates": [
  {
   "id": "G-DEV-WIPE",
   "params": {
    "guardrail": "GR-D1",
    "when": [
     {
      "fact": "valuer.imei",
      "op": "exists",
      "value": true
     }
    ],
    "exception": "missing_wipe_certificates",
    "kept_routes": [
     "recycle"
    ]
   },
   "active": true
  },
  {
   "id": "G-DEV-LOCK",
   "params": {
    "recheck_days": 7,
    "locked_routes": [
     "parts",
     "recycle"
    ],
    "exception": "blacklist_hit"
   },
   "active": true
  },
  {
   "id": "G-DEV-QUOTE",
   "params": {},
   "active": true
  }
 ],
