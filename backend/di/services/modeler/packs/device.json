 "customer_layer": {
  "editable": {
   "GR-D2": [
    "floor"
   ]
  },
  "params": {
   "device.floor": {
    "value": 0.55,
    "min": 0.55,
    "max": 0.9
   }
  },
  "sample_diversions": [
   {
    "text": "Retail partner P02 or P04: a second grading check",
    "op": {
     "op": "add_step",
     "stage": "condition",
     "step": "Second grading check",
     "owner_role": "Planner",
     "when": [
      {
       "fact": "valuer.partner",
       "op": "in",
       "value": [
        "P02",
        "P04"
       ]
      }
     ]
    },
    "blocked": false,
    "reason": "Adds a step at Diagnose and grade: the case waits for a second lab grading (grading_second); the gates still run first."
   },
   {
    "text": "Grade C and the model over 3 years old: straight to a wholesale lot",
    "op": {
     "op": "shortcut",
     "stage": "value",
     "to": "wholesale",
     "when": [
      {
       "fact": "valuer.grade",
       "op": "eq",
       "value": "C"
      },
      {
       "fact": "valuer.inputs.model_age_months",
       "op": "gte",
       "value": 36.1
      }
     ]
    },
    "blocked": false,
    "reason": "Starts after the wipe, registry and quote gates; they still run, and a channel they block stays blocked."
   },
   {
    "text": "Quote under $50: skip the blacklist check",
    "op": {
     "op": "shortcut",
     "stage": "receive",
     "when": [
      {
       "fact": "quote.amount",
       "op": "lte",
       "value": 49
      }
     ],
     "to": "condition"
    },
    "blocked": true,
    "reason": "Blocked: this skips the compliance guardrail GR-D7 (G-DEV-LOCK), the blacklist and lock check."
   }
  ],
  "merge_rule": "stricter_wins"
 },
