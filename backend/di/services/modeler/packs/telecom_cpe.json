 "data": {
  "systems": [
   {
    "type": "cpe_bss",
    "name": "Subscriber returns and CPE refurbishment",
    "adapter": "registry",
    "system_of_record": true
   },
   {
    "type": "erp",
    "name": "ERP",
    "adapter": "registry",
    "system_of_record": false
   }
  ],
  "entities": [
   {
    "name": "Subscriber return",
    "canonical": "asset"
   },
   {
    "name": "Factory-reset record",
    "canonical": "condition.factory_reset"
   },
   {
    "name": "Lot of one model and grade",
    "canonical": "asset.lot_serials"
   },
   {
    "name": "New-subscriber forecast",
    "canonical": "demand.new_subscriber_forecast"
   }
  ],
  "mappings": [
   {
    "kind": "threshold",
    "value": 0.8
   },
   {
    "kind": "intake_trigger",
    "source": "cpe_bss",
    "resource": "lot_grades",
    "when": null,
    "reason": "rma",
    "key": "lot"
   },
   {
    "kind": "evidence",
    "evidence_type": "sanitisation_record",
    "model": "condition",
    "key": "serial",
    "fields": [
     "factory_reset"
    ],
    "source": "cpe_bss"
   }
  ],
  "min_fields": [],
  "record_match": null
 },
 "valuer": {
  "kind": "standard",
  "carbon": {
   "set": "cpe_gsma_2025",
   "d_rule": "demand"
  },
  "params": {
   "params": {
    "plugin": "telecom_cpe",
    "decision_unit": "lot",
    "lot_per": "one model and grade per week",
    "refurb_cost": 19,
    "ship_per_unit": 8,
    "broker_ship_per_unit": 4,
    "broker_fee_pct": 0.1,
    "teardown_per_unit": 4,
    "recycle_fee_per_unit": 2,
    "parts_per_unit": 9,
    "scrap_per_unit": 1.5,
    "carbon_d": {
     "refurbish_redeploy": 1,
     "against": "the new-subscriber forecast"
    }
   },
   "tables": {
    "redeploy_value": {
     "A": 66,
     "B": 58,
     "C": 44,
     "D": 20
    },
    "broker_price": {
     "A": 34,
     "B": 26,
     "C": 18,
     "D": 8
    }
   },
   "requires": [
    {
     "route": "refurbish_redeploy",
     "requires": [
      {
       "fact": "lot.released",
       "op": "gte",
       "value": 1
      }
     ],
     "why": "No device of the lot has a reset record yet"
    }
   ],
   "lines": [
    {
     "route": "refurbish_redeploy",
     "type": "v",
     "label": "Resale to new subscribers",
     "basis": "released devices x value by grade",
     "amount": {
      "mul": [
       {
        "field": "lot.released"
       },
       {
        "table": "redeploy_value",
        "by": [
         "grade"
        ]
       }
      ]
     }
    },
    {
     "route": "refurbish_redeploy",
     "type": "c",
     "label": "Refurbish",
     "basis": "released devices x refurbish cost",
     "amount": {
      "mul": [
       {
        "field": "lot.released"
       },
       {
        "param": "refurb_cost"
       }
      ]
     }
    },
    {
     "route": "refurbish_redeploy",
     "type": "c",
     "label": "Ship to the new subscriber",
     "basis": "released devices x shipping",
     "amount": {
      "mul": [
       {
        "field": "lot.released"
       },
       {
        "param": "ship_per_unit"
       }
      ]
     }
    },
    {
     "route": "broker",
     "type": "v",
     "label": "Broker price",
     "basis": "devices x price by grade",
     "amount": {
      "mul": [
       {
        "field": "qty"
       },
       {
        "table": "broker_price",
        "by": [
         "grade"
        ]
       }
      ]
     }
    },
    {
     "route": "broker",
     "type": "h",
     "label": "Broker fee",
     "basis": "fee share of the price",
     "kind": "fees",
     "amount": {
      "mul": [
       {
        "field": "qty"
       },
       {
        "table": "broker_price",
        "by": [
         "grade"
        ]
       },
       {
        "param": "broker_fee_pct"
       }
      ]
     }
    },
    {
     "route": "broker",
     "type": "c",
     "label": "Ship to the broker",
     "basis": "devices x shipping",
     "amount": {
      "mul": [
       {
        "field": "qty"
       },
       {
        "param": "ship_per_unit"
       }
      ]
     }
    },
    {
     "route": "harvest",
     "type": "v",
     "label": "Parts value",
     "basis": "devices x parts value",
     "amount": {
      "mul": [
       {
        "field": "qty"
       },
       {
        "param": "parts_per_unit"
       }
      ]
     }
    },
    {
     "route": "harvest",
     "type": "c",
     "label": "Teardown",
     "basis": "devices x teardown",
     "amount": {
      "mul": [
       {
        "field": "qty"
       },
       {
        "param": "teardown_per_unit"
       }
      ]
     }
    },
    {
     "route": "recycle",
     "type": "v",
     "label": "Scrap value",
     "basis": "devices x scrap value",
     "amount": {
      "mul": [
       {
        "field": "qty"
       },
       {
        "param": "scrap_per_unit"
       }
      ]
     }
    },
    {
     "route": "recycle",
     "type": "c",
     "label": "Recycling fee",
     "basis": "devices x fee",
     "amount": {
      "mul": [
       {
        "field": "qty"
       },
       {
        "param": "recycle_fee_per_unit"
       }
      ]
     }
    }
   ]
  }
 },
