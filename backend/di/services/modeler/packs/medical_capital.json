 "guardrails": [
  {
   "id": "G-MED-1",
   "text": "The planned work has a regulatory assessment: servicing, or remanufacturing only where we have manufacturer status",
   "owner": "regulatory",
   "type": "Compliance",
   "stage": "decide",
   "locked": true,
   "forbids": [],
   "protects": [],
   "approvers": [],
   "param": null
  },
  {
   "id": "G-MED-2",
   "text": "A single-use device is never reused or resold",
   "owner": "regulatory",
   "type": "Compliance",
   "stage": "match",
   "locked": true,
   "forbids": [],
   "protects": [],
   "approvers": [],
   "param": null
  },
  {
   "id": "G-MED-3",
   "text": "A sale in another market needs the UDI, the service record and closed recalls",
   "owner": "regulatory",
   "type": "Compliance",
   "stage": "value",
   "locked": true,
   "forbids": [],
   "protects": [],
   "approvers": [],
   "param": null
  },
  {
   "id": "G-DATA-3",
   "text": "Imaging systems and monitors are sanitised, with a record, before any release route",
   "owner": "regulatory",
   "type": "Compliance",
   "stage": "execute",
   "locked": true,
   "forbids": [],
   "protects": [],
   "approvers": [],
   "param": null
  },
  {
   "id": "G-MED-FSN",
   "text": "No open field safety notice or recall",
   "owner": "clinical_engineering",
   "type": "Compliance",
   "stage": "condition",
   "locked": false,
   "forbids": [],
   "protects": [],
   "approvers": [],
   "param": null
  }
 ],
