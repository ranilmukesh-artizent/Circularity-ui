    },
    {
     "route": "recycle",
     "type": "v",
     "label": "Recycling credit",
     "basis": "material credit",
     "amount": {
      "param": "recycle_credit"
     }
    },
    {
     "route": "recycle",
     "type": "h",
     "label": "Recycling fee",
     "basis": "treatment fee",
     "amount": {
      "param": "recycle_fee"
     }
    }
   ],
   "routes": [
