     "basis": "refurbishment cost",
     "amount": {
      "field": "refurb_cost"
     }
    },
    {
     "route": "refurbish_resell",
     "type": "h",
     "label": "Sales fee",
     "basis": "fee share of the resale price",
     "amount": {
      "mul": [
       {
        "field": "resale_price"
       },
       {
        "param": "resell_fee_pct"
       }
      ]
     }
    },
    {
     "route": "refurbish_resell",
     "type": "c",
     "label": "Logistics",
     "basis": "per device",
     "amount": {
      "param": "logistics"
     }
    },
    {
     "route": "resell_as_is",
     "type": "v",
     "label": "Resale as is",
     "basis": "resale price x as-is factor",
     "amount": {
      "mul": [
       {
        "field": "resale_price"
       },
       {
        "param": "as_is_factor"
       }
      ]
     }
    },
    {
     "route": "resell_as_is",
     "type": "h",
     "label": "Sales fee",
     "basis": "fee share of the as-is price",
     "amount": {
      "mul": [
       {
        "field": "resale_price"
       },
       {
        "param": "as_is_factor"
       },
       {
        "param": "resell_fee_pct"
       }
      ]
     }
    },
    {
     "route": "resell_as_is",
     "type": "c",
     "label": "Logistics",
     "basis": "per device",
     "amount": {
      "param": "logistics"
     }
    },
    {
     "route": "harvest",
     "type": "v",
     "label": "Parts value",
     "basis": "value of the parts",
     "amount": {
      "field": "parts_value"
