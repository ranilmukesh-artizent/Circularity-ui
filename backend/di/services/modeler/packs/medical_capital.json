  "params": {},
  "sample_diversions": [
   {
    "text": "imaging systems \u2192 physics and image quality check",
    "op": {
     "id": "DV-MC-PHYS",
     "op": "add_step",
     "stage": "condition",
     "step": "Physics and image quality check",
     "owner_role": "clinical_engineering",
     "when": [
      {
       "fact": "cls",
       "op": "eq",
       "value": "imaging_system"
      }
     ]
    },
    "blocked": false,
    "reason": "Adds a step at Assess and test; no gate is skipped."
   },
   {
    "text": "urgent sale: skip the regulatory assessment",
    "op": {
     "id": "DV-MC-SKIP",
     "op": "shortcut",
     "stage": "match",
     "to": "value",
     "when": [
      {
       "fact": "request.urgent",
       "op": "eq",
       "value": true
      }
     ]
    },
    "blocked": true,
    "reason": "Blocked: this skips the compliance guardrail G-MED-1, the regulatory assessment of the planned work. Suggestion: record the assessment first; servicing is quick."
   }
  ],
  "merge_rule": "stricter_wins"
 },
