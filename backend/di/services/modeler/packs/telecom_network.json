 "flows": [
  {
   "key": "decommissioned",
   "name": "Decommissioned network kit"
  }
 ],
 "prompts": [
  "Decommissioned network kit: when radios, baseband units, routers, line cards, power units or microwave links come off a site, match them to the network inventory, wipe and test them, then redeploy them to a site that needs them, keep them as regional spares, resell them to a broker, harvest boards or recycle them. Export-control check before any resale.",
  "Site-swap returns to open site demand",
  "Spares before new purchases"
 ],
 "clarify": {
  "question": "Should units with firmware two or more major versions behind be upgraded before redeployment?",
  "options": [
   {
    "label": "Yes, always upgrade first",
    "adds": "[{\"id\": \"op-1\", \"op\": \"add_step\", \"stage\": \"decide\", \"when\": [{\"fact\": \"asset.firmware_major_gap\", \"op\": \"gte\", \"value\": 2}], \"step\": \"Upgrade firmware before redeploy\", \"owner_role\": \"test_bench_lead\", \"note\": \"BR-TN-FW: two or more major versions behind → upgrade before redeploy\"}]"
   },
   {
    "label": "Only for core sites",
    "adds": "[{\"id\": \"op-1\", \"op\": \"add_step\", \"stage\": \"decide\", \"when\": [{\"fact\": \"asset.firmware_major_gap\", \"op\": \"gte\", \"value\": 2}, {\"fact\": \"asset.site_kind\", \"op\": \"eq\", \"value\": \"core\"}], \"step\": \"Upgrade firmware before redeploy\", \"owner_role\": \"test_bench_lead\", \"note\": \"BR-TN-FW: two or more major versions behind → upgrade before redeploy (scope: asset.site_kind == \\\"core\\\")\"}]"
   }
  ]
 },
