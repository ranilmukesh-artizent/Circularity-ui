  "sample_diversions": [
   {
    "text": "unit from a core site → security inspection",
    "op": {
     "id": "DV-TN-CORE",
     "op": "add_step",
     "stage": "condition",
     "step": "Security inspection",
     "owner_role": "test_bench_lead",
     "when": [
      {
       "fact": "asset.site_kind",
       "op": "eq",
       "value": "core"
      }
     ]
    },
    "blocked": false,
    "reason": "Adds a step at Wipe and test; no gate is skipped."
   },
   {
    "text": "firmware behind → upgrade step",
    "op": {
     "id": "DV-TN-FW",
     "op": "add_step",
     "stage": "condition",
     "step": "Firmware upgrade",
     "owner_role": "test_bench_lead",
     "when": [
      {
       "fact": "asset.firmware_major_gap",
       "op": "gte",
       "value": 1
      }
     ]
    },
    "blocked": false,
    "reason": "Adds a step at Wipe and test; no gate is skipped."
   },
   {
    "text": "urgent site outage: skip the configuration wipe",
    "op": {
     "id": "DV-TN-SKIP",
     "op": "shortcut",
     "stage": "match",
     "to": "value",
     "when": [
      {
       "fact": "site.outage_urgent",
       "op": "eq",
       "value": true
      }
     ]
    },
    "blocked": true,
    "reason": "Blocked: this skips the compliance guardrail G-NET-CFG, the configuration wipe. Suggestion: send an already wiped spare from the nearest pool."
   }
  ],
  "merge_rule": "stricter_wins"
