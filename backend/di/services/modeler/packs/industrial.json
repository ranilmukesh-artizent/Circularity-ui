  "Industrial assets come back from the field and from leases. Decide the route for each: redeploy, resale, internal parts use, re-lease, material recovery, external parts sale or exit. A person approves every decision before it runs.",
  "Value every route for a returned motor, pump, drill, control unit, tool batch or IT asset",
  "Never release an asset without its erasure certificate or its safety recertification"
 ],
 "clarify": {
  "question": "When a decision waits for approval longer than the SLA, who steps in?",
  "options": [
   {
    "label": "The approver's delegate decides",
    "adds": "[{\"id\": \"op-1\", \"op\": \"add_approver\", \"target\": \"GR-I5\", \"role\": \"Approver\"}]"
   },
   {
    "label": "The decision stays with the named owner",
    "adds": "Keeps the pack's approval rule as it is."
   }
  ]
