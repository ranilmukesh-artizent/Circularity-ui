{
 "agents": [
  {
   "calls": 312,
   "id": "assembler",
   "limit": "Read-only. Cannot change eligibility.",
   "name": "Evidence Assembler",
   "scopes": [
    "evidence:read"
   ],
   "step": "1–2",
   "tools": [
    "get_case_evidence",
    "list_eligible_routes",
    "get_model_validation"
   ]
  },
  {
   "calls": 268,
   "id": "finder",
   "limit": "Proposes candidates. Cannot commit stock or price.",
   "name": "Opportunity Finder",
   "scopes": [
    "demand:read",
    "market:read",
    "pool:read"
   ],
   "step": "2–4",
