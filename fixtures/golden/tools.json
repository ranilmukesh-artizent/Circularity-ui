    "list_eligible_routes",
    "get_case_evidence"
   ]
  },
  {
   "calls": 84,
   "id": "gap",
   "limit": "May request inspections and tests up to 5 per case.",
   "name": "Gap Requester",
   "scopes": [
    "evidence:read",
    "request:write"
   ],
   "step": "2",
   "tools": [
    "get_case_evidence",
    "request_missing_evidence"
   ]
  },
  {
   "calls": 151,
   "id": "coordinator",
   "limit": "Sends only what a person approved. Spend capped at the approved amount.",
