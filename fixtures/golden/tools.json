   "scopes": [
    "instruction:write"
   ],
   "step": "6",
   "tools": [
    "get_case_evidence",
    "request_approval",
    "send_instruction"
   ]
  },
  {
   "calls": 197,
   "id": "reconciler",
   "limit": "Links actuals to the decision. Cannot edit the original evidence snapshot.",
   "name": "Reconciler",
   "scopes": [
    "outcome:write",
    "evidence:read"
   ],
   "step": "10",
   "tools": [
    "get_case_evidence",
    "reconcile_outcome",
    "get_model_validation"
   ]
  },
  {
   "calls": 0,
   "id": "briefer",
   "limit": "Read-only. Summarises what needs you.",
   "name": "Briefing Agent",
   "scopes": [
    "inbox:read",
    "metrics:read"
   ],
   "step": "All",
   "tools": [
    "inbox.get",
    "cases.list",
    "analytics.query"
   ]
  },
  {
   "calls": 0,
   "id": "analyst",
   "limit": "Read-only. Explains numbers from closed decisions.",
   "name": "Analytics Explainer",
   "scopes": [
    "metrics:read"
   ],
   "step": "10",
   "tools": [
    "analytics.query",
    "kpi.explain",
    "analytics.models"
   ]
  },
  {
   "calls": 0,
   "id": "integrator",
   "limit": "Drafts mappings, links and workflows. Never saves, publishes or changes a connection.",
   "name": "Integration Assistant",
   "scopes": [
    "sources:read",
    "mapping:draft",
    "workflow:draft"
   ],
   "step": "1",
   "tools": [
    "sources.health",
    "mapping.suggest",
    "tables.suggestLinks",
    "workflow.draft",
    "workflow.validate",
    "import.clean"
   ]
  },
  {
   "calls": 0,
   "id": "auditor",
   "limit": "Read-only. Never edits the audit trail or a snapshot.",
   "name": "Audit Assistant",
   "scopes": [
    "audit:read"
   ],
   "step": "All",
