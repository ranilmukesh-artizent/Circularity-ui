# Dependency direction of the di package (docs/agents/plans/01b-refactor.md, D5; finding F1). Run from apps/api:
#   lint-imports
# 1. The screens are leaves: the read endpoints per page area import the domain (di.reads, di.actions, di.policy ...),
#    never the other way round, and no screen imports another; only di.main (which mounts their routers) imports them.
# 2. Layers: the screens sit on the reads, the reads on the case store, the canonical store and the engine.
[importlinter]
root_package = di
include_external_packages = False
# Imports under `if TYPE_CHECKING:` exist only for mypy (di.actions.registry names CallContext that way) and set no
# runtime dependency direction.
exclude_type_checking_imports = True

[importlinter:contract:screens-are-leaves]
name = Only di.main imports di.screens
type = forbidden
source_modules =
    di.actions
    di.ask
    di.auth
    di.canonical
    di.cases
    di.clock
    di.config
    di.connectors
    di.db
    di.deps
    di.engine
    di.errors
    di.execution
    di.golden
    di.instructions
    di.jobs
    di.mcp
    di.models
    di.policy
    di.reads
    di.routers
    di.state
    di.stream
    di.worker
forbidden_modules =
    di.screens

[importlinter:contract:screens-independent]
name = Screens do not import each other
type = independence
modules =
    di.screens.access
    di.screens.analytics
    di.screens.audit
    di.screens.case
    di.screens.checks
    di.screens.command
    di.screens.home
    di.screens.integration
    di.screens.mcp
    di.screens.nav
    di.screens.orchestration
    di.screens.product
    di.screens.reference
    di.screens.workflows

[importlinter:contract:layers]
name = Screens over reads over the case store, canonical store and engine
type = layers
layers =
    di.screens
    di.reads
    di.cases : di.canonical : di.engine
