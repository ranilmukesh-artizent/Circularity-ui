# The production web server (frontend/Dockerfile.runtime, built from the repo root): serves the built app (dist) and proxies /api and
# /mcp to di-api. The nginx image renders this template into /etc/nginx/conf.d/default.conf at start-up, replacing
# ${API_UPSTREAM} (default http://api:8000, set in the Dockerfile). nginx's own $variables are left alone.

# The access log has the path without the query string: the live stream carries a short-lived stream ticket as
# ?ticket=... (EventSource cannot send headers), and it must not reach the log.
log_format circ_noquery '$remote_addr [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent '
                        '$request_time "$http_user_agent"';

server {
    listen 8080;
    listen [::]:8080;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;
    access_log /dev/stdout circ_noquery;
    client_max_body_size 25m;

    # Content-Security-Policy: everything from this origin, except
    #   style-src  the Google Fonts stylesheet (index.html links it);
    #   font-src   the font files it points to;
    #   img-src    data: for the logos in src/assets/assets.gen.ts (base64 PNG);
    #   style-src-attr 'unsafe-inline'  only for style attributes in markup: the Workflow Studio's trusted HTML strings
    #              (src/api/workflows.ts: vendor logo hue and icon tile colour, style="--h:..." / "--c:...") go through
    #              innerHTML. React's style props are set through the CSSOM and need no exception. No inline
    #              <style> elements and no inline or eval'd scripts are allowed.
    # The add_header lines are inherited only by locations that have no add_header of their own: keep caching to
    # `expires` below.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; style-src-attr 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Server-sent events: the live stream, Ask's streamed answer and the MCP server must not be buffered.
    location = /api/stream {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }
    location = /api/ask {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 120s;
    }
    location /mcp {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Connection "";
    }

    # Vite's hashed bundles never change; the product photos are not hashed.
    location /assets/products/ {
        expires 1h;
    }
    location /assets/ {
        expires max;
    }
    # The single-page app: unknown paths get index.html, which is never cached so a deploy is picked up.
    location / {
        try_files $uri $uri/ /index.html;
        expires -1;
    }
}
