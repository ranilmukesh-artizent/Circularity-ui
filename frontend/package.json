{
  "name": "circularity-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node scripts/extract-styles.mjs",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node scripts/extract-styles.mjs",
    "build": "tsc -b && vite build",
    "pretest": "node scripts/extract-styles.mjs",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "knip": "knip",
    "preview": "vite preview",
    "assets": "node scripts/dump-assets.mjs",
    "golden": "node scripts/dump-golden.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.3",
    "@tanstack/react-query": "5.62.7",
    "@xyflow/react": "12.12.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "9.39.5",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "knip": "6.44.1",
    "typescript": "5.6.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
