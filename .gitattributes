# Every text file is stored and checked out with LF, on every OS (a CR breaks shell scripts in Linux containers:
# "$'\r': command not found", and Windows checkouts with core.autocrlf would otherwise differ from the index).
* text=auto eol=lf

# Binary files: no line-ending conversion, no text diff.
*.webp binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.pptx binary
*.woff binary
*.woff2 binary
